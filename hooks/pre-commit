#!/bin/bash
# =============================================================================
# pre-commit — refuse at COMMIT what G-E would only detect at WRAP.
#
# Born 2026-08-08 (S45), from the S44 finding: the estate's pre-commit protection
# was per-repo and uneven, and .git/hooks is untracked so no gate could even SEE
# which repos were protected. This hook + install-estate-hooks.sh + G-AF close
# that: one needle (secret-re.sh), every repo, and the gate proves the wiring.
#
# 2026-08-26: a SECOND axis alongside the needle -- estate_leakguard() below refuses
# the literal values this box actually holds, because a credential with no vendor
# prefix (a Cloudflare token) has no shape a regex can safely match.
#
# Scans the STAGED INDEX, never the working tree. `git grep --cached` reads the
# index, which is exactly what the commit will contain. Working-tree scanning is
# wrong twice over (global lesson 2026-07-08): it MISSES a staged secret whose
# file was since edited, and in a CONCURRENT Cowork session sharing darwin's tree
# it FAILS on another session's unstaged edit that this commit never touches.
#
# Fails CLOSED. Escape hatches, in order of preference:
#   1. the hit is real  -> scrub it, and ROTATE the credential (it is burned)
#   2. the hit is noise -> name it, WITH A REASON, in gate-secret-sweep.allow
#   3. you are certain  -> git commit --no-verify   (deliberate, one commit only)
# =============================================================================
set -uo pipefail
HOOK_DIR="$(cd "$(dirname "$0")" && pwd -P)"
LIB="${ESTATE_SECRET_LIB:-$HOOK_DIR/secret-re.sh}"

if [ ! -f "$LIB" ]; then
  echo "estate pre-commit: FATAL — secret regex SSOT missing: $LIB" >&2
  echo "  Failing CLOSED (a security control that cannot load must not pass)." >&2
  echo "  Fix: restore ~/code/darwin-mac-ops/hooks/secret-re.sh (git checkout), or" >&2
  echo "       bypass this ONE commit with: git commit --no-verify" >&2
  exit 1
fi
. "$LIB"
ge_load_allow

# --- the roster brake (A1, 2026-08-14; State Machine 1217468064910605) ------------
# Deferred six sessions. Every cloud session shares ONE working tree on darwin, and
# `git add -A` stages a sibling's half-finished edits under YOUR message; the roster's
# OTHER hook only says so post-commit, after the damage. This refuses exactly the
# `add -A` shape under a FRESH claim by another session, and fails OPEN on everything
# else -- deliberately unlike the secret scan above it, whose blast radius is one
# credential rather than every commit on a machine running 11 concurrent sessions.
# Runs AFTER the secret scan so the security control always speaks first.
# --- the identity layer (2026-08-26, opus-pnsTock) ---------------------------------
# SECRET_RE above matches SHAPES, which only reaches credentials carrying a vendor
# prefix. A Cloudflare API token is 52 characters of base64-ish nothing; on 2026-08-25
# the live DNS:Edit-on-all-26-zones token reached a transcript and neither this hook nor
# G-E could have seen it, because there is no pattern to see.
#
# leakguard.py matches IDENTITY: it reads the secret-bearing files this box actually
# holds (SSOT for the inventory: secrets/SECRETS.md) and refuses those exact literals in
# the staged index. Different axis, same index, one process for the whole commit.
#
# Fails OPEN-BUT-LOUD, unlike the regex above. The regex needle is repo-backed and
# versioned beside this hook, so its absence is corruption and must fail closed; the
# identity layer depends on ~/Scripts/leakguard.py plus live files under ~/.config that
# a fresh clone legitimately will not have. Blocking every commit on a machine that has
# not been set up yet would get the whole hook chain uninstalled, so it says so instead.
estate_leakguard() {
  local lg="${ESTATE_LEAKGUARD:-$HOME/Scripts/leakguard.py}"
  if [ ! -f "$lg" ]; then
    echo "estate pre-commit: NOTE — identity layer inert (no $lg); shape layer still ran" >&2
    return 0
  fi
  local out
  out="$(python3 "$lg" git-index 2>&1)" || {
    echo "" >&2
    echo "estate pre-commit: BLOCKED — the staged index carries a credential THIS BOX HOLDS" >&2
    printf '%s\n' "$out" | sed 's/^/  /' >&2
    cat >&2 <<'LGWHY'

  This is not a shape guess. The literal in your staged file is byte-identical to a
  value in one of the files listed by `python3 ~/Scripts/leakguard.py sources`.

  To LOOK at the offending file safely:  python3 ~/Scripts/leakguard.py mask <file>
  If it is real:  scrub it and ROTATE the credential — see secrets/SECRETS.md.
  If you are sure it is fine:  git commit --no-verify   (this commit only)
LGWHY
    return 1
  }
  return 0
}

estate_roster_brake() {
  local b="$HOME/Scripts/roster-brake.py"
  [ -x "$b" ] || return 0
  python3 "$b" || return 1
  return 0
}

TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
# The allowlist is keyed on the REPO basename -- and a linked worktree has a different basename
# from the repo it is a worktree OF. The rail gives each lane <repo>-lane-<x>, so the moment lane
# worktrees appeared, EVERY reasoned allowlist entry on the estate went invisible from a lane and
# the hook hard-blocked on hits a human had already adjudicated in the main checkout. Key on the
# MAIN checkout: --git-common-dir points at the shared .git from whichever worktree we stand in.
# Fails safe -- if git cannot answer, fall back to this tree's own basename (the old behaviour).
GE_COMMON="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
if [ -n "$GE_COMMON" ] && [ "$(basename "$GE_COMMON")" = ".git" ]; then
  BASE="$(basename "$(dirname "$GE_COMMON")")"
else
  BASE="$(basename "$TOP")"
fi

# Added / Copied / Modified only. A DELETED file cannot introduce a secret, and a
# rename's source is not in the post-commit tree.
declare -a PATHS=()
while IFS= read -r -d '' p; do
  PATHS[${#PATHS[@]}]="$p"
done < <(git diff --cached -z --name-only --diff-filter=ACM 2>/dev/null)

if [ "${#PATHS[@]}" -eq 0 ]; then
  estate_roster_brake || exit 1
  ESTATE_HOOK_NAME=pre-commit exec "$HOOK_DIR/_chain.sh" "$@"
fi

hits=0; pan_hits=0
while IFS= read -r line; do
  [ -z "$line" ] && continue
  f="$(printf '%s' "$line" | cut -d: -f1)"
  if ge_allowed "$BASE/$f"; then
    GE_SUPPRESSED=$((GE_SUPPRESSED+1)); continue
  fi
  if [ "$hits" -eq 0 ]; then
    echo "" >&2
    echo "estate pre-commit: BLOCKED — credential-shaped string(s) in the staged index" >&2
  fi
  floc="$(printf '%s' "$line" | cut -d: -f1-2)"
  printf '    %s: %s  [match: %s]\n' "$BASE" "$floc" "$(ge_mask "$line")" >&2
  hits=$((hits+1))
done < <(git grep --cached -nIE "$SECRET_RE" -- "${PATHS[@]}" 2>/dev/null)

# --- the PAN layer (S15 2026-09-04, SM 1217561601836055) ---------------------------
# THIRD axis, same index, same allowlist. SECRET_RE matches vendor SHAPES and
# leakguard.py matches this box's own LITERALS; a customer's card number is
# neither. It has no prefix to key on and no entropy to measure, so both layers
# above were structurally blind to it while G-AF reported 114 of 114 repos green
# -- coverage without capability, which is the one failure mode that looks exactly
# like success. (A real PAN reached a wisdom repo this way; AAR 2026-08-17.)
#
# Two-stage on purpose: PAN_RE shortlists, ge_pan_token() decides. Reporting a
# raw PAN_RE hit would block commits on every order id in the estate.
while IFS= read -r line; do
  [ -z "$line" ] && continue
  f="$(printf '%s' "$line" | cut -d: -f1)"
  body="${line#*:}"; body="${body#*:}"          # strip file:line:, keep the content
  tok="$(ge_pan_token "$body")" || continue     # the VERDICT — not the grep
  if ge_allowed "$BASE/$f"; then
    GE_SUPPRESSED=$((GE_SUPPRESSED+1)); continue
  fi
  if [ "$hits" -eq 0 ]; then
    echo "" >&2
    echo "estate pre-commit: BLOCKED — card number(s) in the staged index" >&2
  fi
  floc="$(printf '%s' "$line" | cut -d: -f1-2)"
  printf '    %s: %s  [PAN: %s]\n' "$BASE" "$floc" "$tok" >&2
  hits=$((hits+1))
  pan_hits=$((pan_hits+1))
done < <(git grep --cached -nIE "$PAN_RE" -- "${PATHS[@]}" 2>/dev/null)

# Suppression is NEVER silent — a reader has to be able to see what the allowlist ate.
# A silent cap reads as "covered everything" when it did not (S44).
if [ "$GE_SUPPRESSED" -gt 0 ]; then
  printf 'estate pre-commit: %s hit(s) suppressed by %s allowlist rule(s) in %s\n' \
    "$GE_SUPPRESSED" "${#GE_PATS[@]}" "${GE_ALLOW/#$HOME/~}" >&2
fi
if [ "$GE_NOREASON" -gt 0 ]; then
  printf 'estate pre-commit: ⚠ %s allowlist entry/entries have NO REASON (%s) — add "# why" or delete\n' \
    "$GE_NOREASON" "$(printf '%s ' "${GE_NOREASON_PATS[@]}")" >&2
fi

if [ "$hits" -gt 0 ]; then
  cat >&2 <<'WHY'

  This is a HARD block, on purpose: a credential that reaches a commit is burned even
  if you amend it away one second later — the object stays in the repo, and in every
  clone and fork of it. Cheaper to stop here.

  If it is REAL:   scrub it from the staged file AND rotate the credential.
                   Test it first if you can — the answer changes the action:
                   a 401 means this is a commit, a 200 means it is an incident.
  If it is NOISE:  add "<repo>/<path-glob>   # why this cannot be a live credential"
                   to ~/code/darwin-mac-ops/gate-secret-sweep.allow. The reason is
                   mandatory. "It's in a fork" is not a reason.
  If you are sure: git commit --no-verify   (deliberate, this commit only)
WHY
  # A PAN is not a credential you can rotate, and that changes what the next step is:
  # nobody can issue you a new copy of a customer's card number, so the only remedies
  # are scrub-and-rewrite-history and telling whoever owns the incident process.
  if [ "$pan_hits" -gt 0 ]; then
    cat >&2 <<'PANWHY'
  One or more hits above are CARD NUMBERS (first-6/last-4 shown; the rest is masked).
  A PAN is not rotatable — there is no "issue a new one and move on". If it is real:
    * do NOT amend it away and carry on; the blob survives the amend, and the commit
      may already exist in a clone. Scrub the file, then treat the history as suspect.
    * a PAN in a repo is a PCI-scope event, not a hygiene nit. Say so out loud.
  If it is a TEST card (4111…, 4242…, the published Visa/Amex fixtures), it is still
  a real detection — allowlist the FIXTURE PATH with a reason, do not widen the needle.
PANWHY
  fi
  exit 1
fi

estate_leakguard    || exit 1
estate_roster_brake || exit 1

ESTATE_HOOK_NAME=pre-commit exec "$HOOK_DIR/_chain.sh" "$@"
