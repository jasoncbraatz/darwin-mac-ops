<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.braatz.wg-keepalive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/jasoncbraatz/Scripts/wg-keepalive.sh</string>
  </array>
  <!-- RunAtLoad covers the reboot case (login); StartInterval covers ISP/storm drops. -->
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/Users/jasoncbraatz/.local/state/wg-keepalive/stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/jasoncbraatz/.local/state/wg-keepalive/stderr.log</string>
</dict>
</plist>
