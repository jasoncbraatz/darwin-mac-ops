# oauth-keepalive.service -- feynman's twin of launchagents/com.braatz.oauth-keepalive.plist
# (smDrainDesk-14, 2026-09-08). Same script, same cadence. Linux has no keychain: the CLI's
# refresh token in ~/.claude/.credentials.json is readable from any shell, so no GUI domain.
# Installed by: scripts/oauth-keepalive-agent.sh --install (picks launchd vs systemd by platform).
[Unit]
Description=self-heal the fuel gauge's OAuth token when the probe reads 401
Documentation=https://github.com/jasoncbraatz/darwin-mac-ops

[Service]
Type=oneshot
ExecStart=/bin/bash %h/code/darwin-mac-ops/scripts/oauth-keepalive.sh
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=300
